<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.budgetms.ui.controller.DepartmentController"
      spacing="16">
    <Label styleClass="screen-title" text="Departments" />
    <Label styleClass="screen-subtitle"
           text="Nested organisational units. Full create / read / update / delete — a department can't be deleted while it still holds employees or child departments." />

    <HBox spacing="20" VBox.vgrow="ALWAYS">
        <VBox styleClass="card" spacing="10" HBox.hgrow="ALWAYS">
            <Label text="All Departments" style="-fx-font-weight: bold;" />
            <TableView fx:id="departmentTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="nameColumn" text="Name" prefWidth="180" />
                    <TableColumn fx:id="parentColumn" text="Parent" prefWidth="150" />
                    <TableColumn fx:id="employeeCountColumn" text="Employees" prefWidth="90" />
                    <TableColumn fx:id="costColumn" text="Total Cost" prefWidth="110" />
                    <TableColumn fx:id="budgetColumn" text="Active Budget" prefWidth="110" />
                    <TableColumn fx:id="varianceColumn" text="Variance" prefWidth="110" />
                </columns>
            </TableView>
        </VBox>

        <VBox styleClass="card" spacing="12" prefWidth="300" minWidth="280">
            <Label fx:id="formTitleLabel" text="Add Department" style="-fx-font-weight: bold;" />
            <GridPane styleClass="form-grid" vgap="10" hgap="10">
                <columnConstraints>
                    <ColumnConstraints minWidth="80" />
                    <ColumnConstraints hgrow="ALWAYS" />
                </columnConstraints>
                <Label text="Name" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                <TextField fx:id="nameField" promptText="e.g. Computer Science"
                           GridPane.rowIndex="0" GridPane.columnIndex="1" />

                <Label text="Parent" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                <ComboBox fx:id="parentComboBox" maxWidth="Infinity"
                          GridPane.rowIndex="1" GridPane.columnIndex="1" />
            </GridPane>

            <Label fx:id="validationLabel" styleClass="variance-negative" wrapText="true" />

            <HBox spacing="8">
                <Button fx:id="addButton" styleClass="primary-button" text="Add" onAction="#handleAdd" />
                <Button fx:id="updateButton" styleClass="secondary-button" text="Update" onAction="#handleUpdate" disable="true" />
                <Button fx:id="deleteButton" styleClass="danger-button" text="Delete" onAction="#handleDelete" disable="true" />
            </HBox>
            <Button styleClass="secondary-button" text="Clear Form" onAction="#handleClear" maxWidth="Infinity" />
        </VBox>
    </HBox>
</VBox>

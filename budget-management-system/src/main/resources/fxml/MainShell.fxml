<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.budgetms.ui.controller.MainShellController"
            prefWidth="900" prefHeight="600">

    <left>
        <VBox spacing="10">
            <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>
            <Button text="Departments" onAction="#showDepartments" maxWidth="Infinity"/>
            <Button text="Employees" onAction="#showEmployees" maxWidth="Infinity"/>
            <Button text="Budgets" onAction="#showBudgets" maxWidth="Infinity"/>
            <Button text="Budget Browser" onAction="#showBudgetBrowser" maxWidth="Infinity"/>
        </VBox>
    </left>

    <center>
        <StackPane fx:id="contentArea"/>
    </center>

</BorderPane>
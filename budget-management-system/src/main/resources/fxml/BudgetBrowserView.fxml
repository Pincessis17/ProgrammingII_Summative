<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TreeView?>
<?import javafx.scene.layout.VBox?>

<SplitPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.budgetms.ui.controller.BudgetBrowserController"
           dividerPositions="0.4">

    <TreeView fx:id="orgTree"/>

    <VBox spacing="10">
        <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
        <Label text="Details" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
        <Label fx:id="nameLabel" text="Name: -"/>
        <Label fx:id="headcountLabel" text="Headcount: -"/>
        <Label fx:id="costLabel" text="Cost: -"/>
    </VBox>

</SplitPane>
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.budgetms.ui.controller.EmployeeController"
      spacing="16">
    <Label styleClass="screen-title" text="Employees" />
    <Label styleClass="screen-subtitle"
           text="Create / read / update only, by design — no delete, to preserve historical budget and organisational data. Staff who leave are marked inactive instead." />

    <HBox spacing="20" VBox.vgrow="ALWAYS">
        <VBox styleClass="card" spacing="10" HBox.hgrow="ALWAYS">
            <Label text="All Employees" style="-fx-font-weight: bold;" />
            <TableView fx:id="employeeTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="nameColumn" text="Name" prefWidth="160" />
                    <TableColumn fx:id="roleColumn" text="Role" prefWidth="150" />
                    <TableColumn fx:id="departmentColumn" text="Department" prefWidth="150" />
                    <TableColumn fx:id="salaryColumn" text="Salary" prefWidth="100" />
                    <TableColumn fx:id="activeColumn" text="Status" prefWidth="90" />
                </columns>
            </TableView>
        </VBox>

        <VBox styleClass="card" spacing="12" prefWidth="300" minWidth="280">
            <Label fx:id="formTitleLabel" text="Add Employee" style="-fx-font-weight: bold;" />
            <GridPane styleClass="form-grid" vgap="10" hgap="10">
                <columnConstraints>
                    <ColumnConstraints minWidth="80" />
                    <ColumnConstraints hgrow="ALWAYS" />
                </columnConstraints>
                <Label text="Name" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                <TextField fx:id="nameField" promptText="e.g. Aris Okoye"
                           GridPane.rowIndex="0" GridPane.columnIndex="1" />

                <Label text="Role" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                <TextField fx:id="roleField" promptText="e.g. Lecturer"
                           GridPane.rowIndex="1" GridPane.columnIndex="1" />

                <Label text="Salary" GridPane.rowIndex="2" GridPane.columnIndex="0" />
                <TextField fx:id="salaryField" promptText="e.g. 2600"
                           GridPane.rowIndex="2" GridPane.columnIndex="1" />

                <Label text="Department" GridPane.rowIndex="3" GridPane.columnIndex="0" />
                <ComboBox fx:id="departmentComboBox" maxWidth="Infinity"
                          GridPane.rowIndex="3" GridPane.columnIndex="1" />

                <Label text="Active" GridPane.rowIndex="4" GridPane.columnIndex="0" />
                <CheckBox fx:id="activeCheckBox" selected="true"
                          GridPane.rowIndex="4" GridPane.columnIndex="1" />
            </GridPane>

            <Label fx:id="validationLabel" styleClass="variance-negative" wrapText="true" />

            <HBox spacing="8">
                <Button fx:id="addButton" styleClass="primary-button" text="Add" onAction="#handleAdd" />
                <Button fx:id="updateButton" styleClass="secondary-button" text="Update" onAction="#handleUpdate" disable="true" />
            </HBox>
            <Button styleClass="secondary-button" text="Clear Form" onAction="#handleClear" maxWidth="Infinity" />
        </VBox>
    </HBox>
</VBox>

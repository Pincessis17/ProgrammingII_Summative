<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.budgetms.ui.controller.EmployeeController">

    <top>
        <VBox spacing="10">
            <padding><Insets top="15" right="15" bottom="10" left="15"/></padding>
            <Label text="Employees" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
            <HBox spacing="10">
                <TextField fx:id="nameField" promptText="Name"/>
                <TextField fx:id="roleField" promptText="Role"/>
                <TextField fx:id="salaryField" promptText="Salary"/>
                <ComboBox fx:id="departmentPicker" promptText="Department (optional)"/>
                <Button text="Add" onAction="#handleAdd"/>
                <Button text="Toggle Active" onAction="#handleToggleActive"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <TableView fx:id="employeeTable">
            <columns>
                <TableColumn fx:id="nameColumn" text="Name" prefWidth="160"/>
                <TableColumn fx:id="roleColumn" text="Role" prefWidth="140"/>
                <TableColumn fx:id="salaryColumn" text="Salary" prefWidth="100"/>
                <TableColumn fx:id="activeColumn" text="Active" prefWidth="80"/>
            </columns>
        </TableView>
    </center>

</BorderPane>
